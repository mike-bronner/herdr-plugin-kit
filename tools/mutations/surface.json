{
  "file": "crates/herdr-plugin-kit/src/surface.rs",
  "command": [
    "cargo",
    "test",
    "--features",
    "dialog",
    "--lib",
    "--test",
    "dialog"
  ],
  "mutations": [
    {
      "name": "the busy code is matched exactly",
      "find": "BUSY_CODE => OpenError::Busy,",
      "replace": "\"ui_bus\" => OpenError::Busy,"
    },
    {
      "name": "anything that is not the busy code stays a plain failure",
      "find": "other => OpenError::Failed(format!(\"{}: {}\", other, message)),",
      "replace": "_ => OpenError::Busy,"
    },
    {
      "name": "a transport that cannot send the pre-check still opens the popup",
      "find": "Err(\"this transport cannot send client.window_title.clear\".to_string())",
      "replace": "Ok(ClientWindowTitleReason::NoForegroundClient)"
    }
  ]
}
